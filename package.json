{
  "name": "along-the-way",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev:api": "bun --watch apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "bun run build:api && bun run build:web",
    "build:api": "bun build apps/api/src/server.ts --target bun --outdir apps/api/dist",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\" --exclude \"apps/web/e2e/**\"",
    "test:watch": "vitest --exclude \"**/*.integration.test.ts\" --exclude \"apps/web/e2e/**\"",
    "test:integration": "vitest run apps/api/test/postgres-trip-summary-store.integration.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "bun apps/api/src/database/migrate.ts",
    "db:seed": "bun apps/api/src/database/seed.ts"
  },
  "dependencies": {
    "@along-the-way/contracts": "workspace:*",
    "hono": "4.13.2",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}

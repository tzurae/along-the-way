# Copy to .env before running Docker Compose.
# Keep the password URL-safe because it is embedded in DATABASE_URL.
POSTGRES_DB=along_the_way
POSTGRES_ADMIN_USER=along_the_way_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-admin-secret
APP_DATABASE_USER=along_the_way_app
APP_DATABASE_PASSWORD=replace-with-a-different-url-safe-app-secret
RELEASE_IMAGE_TAG=local

# Local: http://localhost
# Staging with automatic HTTPS: https://YOUR_STATIC_IP.sslip.io
SITE_ADDRESS=http://localhost

# Copy to .env before running Docker Compose.
# Keep the password URL-safe because it is embedded in DATABASE_URL.
POSTGRES_DB=along_the_way
POSTGRES_ADMIN_USER=along_the_way_admin
POSTGRES_ADMIN_PASSWORD=replace-with-a-long-url-safe-admin-secret
APP_DATABASE_USER=along_the_way_app
APP_DATABASE_PASSWORD=replace-with-a-different-url-safe-app-secret
RELEASE_IMAGE_TAG=local
BOOTSTRAP_OWNER_EMAIL=owner@example.test
# Comma-separated, case-insensitive email allowlist for the global admin view.
ADMIN_EMAILS=owner@example.test
# Local development uses Mailpit and must start Compose with `--profile local`.
# Staging overrides these values with authenticated Gmail SMTP.
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=Along the Way <along-the-way@example.test>
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
TOKEN_SECRET=replace-with-at-least-32-random-bytes
# Server-only Google Maps Platform credential for Places API (New). Leave blank to use manual intake only.
GOOGLE_MAPS_API_KEY=
# Browser key: restrict by HTTP referrer to this site and Maps JavaScript API only.
# Map ID enables advanced markers. The app budget is 310 loads/day; set the Google quota to 320/day.
GOOGLE_MAPS_BROWSER_KEY=
GOOGLE_MAPS_MAP_ID=
# Cloud Monitoring reads both projects with one service-account JSON key mounted into the API.
GCP_MONITORING_PROJECTS=test-along:正式站,along-the-way-dev:開發
# Keep the real key outside the repository. The checked-in default points to an empty {} placeholder.
GCP_MONITORING_CREDENTIALS_HOST_FILE=./infra/gcp-monitoring.empty.json
# Server-only OpenAI Responses API credential and model. Leave the key blank to keep existing trip data available while AI discovery is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Local: http://localhost
# Staging must use an HTTPS hostname on a domain you control.
SITE_ADDRESS=http://localhost
